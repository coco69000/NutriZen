# Version minimale iOS 16.0 pour mobile_scanner 6.x et Google ML Kit
platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get was executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Forcer tous les pods à utiliser iOS 16.0
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['SDKROOT'] ||= 'iphoneos'
      
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_SENSORS=1'
      ]
    end
  end

  # Correction pour device_info_plus (erreur isiOSAppOnVision sur Xcode 15/16)
  Dir.glob("#{File.dirname(__FILE__)}/**/FPPDeviceInfoPlusPlugin.h").each do |header|
    content = File.read(header)
    unless content.include?('isiOSAppOnVision')
      File.write(header, content + "\n@interface NSProcessInfo (VisionFix)\n- (BOOL)isiOSAppOnVision;\n@end\n")
    end
  end
  Dir.glob("#{File.dirname(__FILE__)}/**/FPPDeviceInfoPlusPlugin.m").each do |src|
    content = File.read(src)
    if content.include?('[info isiOSAppOnVision]')
      patched = content.gsub('[info isiOSAppOnVision]', 'NO')
      File.write(src, patched)
    end
  end
end
