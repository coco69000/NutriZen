rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection "users"
    match /users/{userId} {
      // Un utilisateur connecté peut lire et écrire uniquement son propre document
      allow read: if isOwner(userId);
      
      // Empêcher la création ou modification directe de 'isPremium' ou 'role' depuis le client
      allow create: if isOwner(userId) 
        && !('isPremium' in request.resource.data) 
        && !('role' in request.resource.data);

      allow update: if isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium', 'role', 'subscriptionStatus',
          'rank_score', 'rank_breakdown', 'rank_streak', 'rank_badges', 
          'rank_goalProgress', 'rank_weeklyKcal', 'rank_steps', 'rank_goalType',
          'rank_weightDelta', 'rank_currentWeight', 'rank_waterAdherence',
          'rank_mealsLogged', 'rank_fastingSessions', 'rank_aiAnalyses',
          'evo_score', 'evo_weight', 'evo_activity', 'evo_nutrition'
        ]))
        && (request.resource.data.countryCode == resource.data.countryCode || resource.data.countryCode == null)
        || request.auth.token.admin == true;

      // Sous-collection badges (seul le backend Admin SDK via Cloud Function peut écrire)
      match /badges/{badgeId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Sous-collection subscription (statut de paiement géré côté serveur)
      match /subscription/{subDoc} {
        allow read: if isOwner(userId);
        // Seules les Cloud Functions (Admin SDK) peuvent modifier le statut d'abonnement
        allow write: if false;
      }

      // Sous-collection usageTracking (suivi de quota géré exclusivement par les Cloud Functions)
      match /usageTracking/{docId} {
        allow read: if isOwner(userId);
        // INTERDIT côté client : seule la Cloud Function (Admin SDK) peut écrire
        allow write: if false;
      }

      // Validation des pesées (weightEntries)
      match /weightEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && request.resource.data.weight is number
                      && request.resource.data.weight >= 20 
                      && request.resource.data.weight <= 300;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Validation des activités physiques
      match /activities/{activityId} {
        allow read: if request.auth != null;
        // Empêche d'entrer des calories irréalistes (> 3000 kcal pour une seule activité)
        allow write: if request.auth.uid == userId 
                     && request.resource.data.caloriesBurned is number 
                     && request.resource.data.caloriesBurned <= 3000;
      }

      match /fastingPrograms/{programId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Autres sous-collections utilisateur (ex: meals, goals, steps)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      // Seul le créateur ou l'adversaire peut modifier le statut, pas les scores directement
      allow update: if (request.auth.uid == resource.data.creatorUid || request.auth.uid == resource.data.opponentUid)
                    && request.resource.data.keys().hasOnly(['status', 'winnerUid']); 
    }

    // Collection des journaux d'audit (admin_logs) : inaccessible côté client
    match /admin_logs/{logId} {
      allow read, write: if false;
    }
  }
}
